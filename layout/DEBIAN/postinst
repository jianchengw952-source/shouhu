#!/bin/sh
set -e

JBROOT=""
# 1. 优先从 postinst 脚本自身路径 ($0) 推导当前越狱根目录 (同时支持 Relaxin .jbroot-* 与 Dopamine /var/jb)
case "$0" in
    */Library/dpkg/info/*)
        JBROOT="${0%/Library/dpkg/info/*}"
        ;;
esac

# 2. 若未推导出来，保持原有判断逻辑
if [ -z "$JBROOT" ] || [ ! -d "$JBROOT" ]; then
    if [ -d "/var/jb" ]; then
        JBROOT="/var/jb"
    else
        JBROOT=$(find /var/containers/Bundle/Application/ -maxdepth 1 -name ".jbroot-*" 2>/dev/null | head -n 1)
    fi
fi

if [ -n "$JBROOT" ]; then
    # 【关键修复】：预先创建数据与证书目录并赋予 0777 与 mobile:mobile 权限，确保桌面 App 100% 可读写！
    DATA_DIR="$JBROOT/var/mobile/Library/AuraSignPro"
    PREF_DIR="$JBROOT/var/mobile/Library/Preferences"
    mkdir -p "$DATA_DIR/KeychainCert" "$DATA_DIR/Vault" "$PREF_DIR"
    chown -R 501:501 "$DATA_DIR" "$PREF_DIR" 2>/dev/null || true
    chmod -R 0777 "$DATA_DIR" 2>/dev/null || true

    APP_DIR="$JBROOT/Applications/AuraSignPro.app"
    mkdir -p "$APP_DIR"

    cat <<EOF > "$APP_DIR/Info.plist"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>续签</string>
    <key>CFBundleExecutable</key>
    <string>AuraSignPro</string>
    <key>CFBundleIdentifier</key>
    <string>com.aurasign.pro</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>AuraSignPro</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.4</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleIconFiles</key>
    <array>
        <string>AppIcon60x60</string>
        <string>icon.png</string>
    </array>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
                <string>icon.png</string>
            </array>
            <key>UIPrerenderedIcon</key>
            <true/>
        </dict>
    </dict>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIDeviceFamily</key>
    <array>
        <integer>1</integer>
        <integer>2</integer>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
EOF

    chmod 755 "$APP_DIR" 2>/dev/null || true
    chmod 755 "$APP_DIR/AuraSignPro" 2>/dev/null || true
    chmod 755 "$APP_DIR/zsign" 2>/dev/null || true
    chmod 644 "$APP_DIR/Info.plist" 2>/dev/null || true

    if [ -x "$JBROOT/usr/bin/aurasignd" ]; then
        "$JBROOT/usr/bin/aurasignd" --gen-icon 2>/dev/null || true
    fi

    if [ -x "$JBROOT/usr/bin/uicache" ]; then
        "$JBROOT/usr/bin/uicache" -p "$APP_DIR" || "$JBROOT/usr/bin/uicache" -a || true
    fi

    mkdir -p "$JBROOT/Library/LaunchDaemons"
    PLIST="$JBROOT/Library/LaunchDaemons/com.aurasign.pro.daemon.plist"
    DAEMON_BIN="$JBROOT/usr/bin/aurasignd"

    cat <<EOF > "$PLIST"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aurasign.pro.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>$DAEMON_BIN</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StartInterval</key>
    <integer>21600</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
EOF

    chown root:wheel "$PLIST" 2>/dev/null || true
    chmod 644 "$PLIST" 2>/dev/null || true
    LAUNCHCTL_BIN="launchctl"
    if [ -x "$JBROOT/bin/launchctl" ]; then
        LAUNCHCTL_BIN="$JBROOT/bin/launchctl"
    elif [ -x "$JBROOT/usr/bin/launchctl" ]; then
        LAUNCHCTL_BIN="$JBROOT/usr/bin/launchctl"
    fi
    "$LAUNCHCTL_BIN" unload "$PLIST" 2>/dev/null || true
    "$LAUNCHCTL_BIN" load -w "$PLIST" 2>/dev/null || true
fi

exit 0
